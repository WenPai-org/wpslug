msgstr "预览"

#: includes/class-wpslug-admin.php:275
msgid "Test your conversion settings with live preview."
msgstr "通过实时预览测试您的转换设置。"

#: includes/class-wpslug-admin.php:281
msgid "Enter text to preview conversion..."
msgstr "输入文本以预览转换..."

#: includes/class-wpslug-settings.php:720
#: templates/admin/page.php:147
#: templates/admin/page.php:267
#: templates/admin/page.php:350
msgid "Enable Plugin"
msgstr "启用插件"

#: includes/class-wpslug-settings.php:721
#: templates/admin/page.php:148
msgid "Enable automatic slug conversion for your content"
msgstr "为您的内容启用自动别名转换"

#: includes/class-wpslug-settings.php:725
msgid "Conversion Mode"
msgstr "转换模式"

#: includes/class-wpslug-settings.php:731
msgid "Auto Convert"
msgstr "自动转换"

#: includes/class-wpslug-settings.php:732
msgid "Automatically convert slugs when saving posts and terms"
msgstr "保存文章和分类项时自动转换别名"

#: includes/class-wpslug-settings.php:741
msgid "Force Lowercase"
msgstr "强制小写"

#: includes/class-wpslug-settings.php:742
msgid "Convert all slugs to lowercase for consistency"
msgstr "将所有别名转换为小写以保持一致性"

#: includes/class-wpslug-admin.php:321
msgid "Configure Chinese characters to Pinyin romanization."
msgstr "配置中文字符转换到拼音。"

#: includes/class-wpslug-settings.php:747
msgid "Pinyin Format"
msgstr "拼音格式"

#: includes/class-wpslug-settings.php:747
msgid "Full Pinyin (ni-hao)"
msgstr "完整拼音（ni-hao）"

#: includes/class-wpslug-settings.php:747
msgid "First Letter Only (n-h)"
msgstr "仅首字母（n-h）"

#: includes/class-wpslug-settings.php:747
msgid "Choose between full pinyin or first letters only. First letter mode creates very concise URLs and automatically disables SEO optimization."
msgstr "选择完整拼音或仅首字母。首字母模式创建非常简洁的 URL 并自动禁用 SEO 优化。"

#: includes/class-wpslug-settings.php:748
msgid "Word Separator"
msgstr "单词分隔符"

#: includes/class-wpslug-settings.php:748
msgid "Hyphen (-)"
msgstr "连字符（-）"

#: includes/class-wpslug-settings.php:748
msgid "Underscore (_)"
msgstr "下划线（_）"

#: includes/class-wpslug-settings.php:748
msgid "No Separator"
msgstr "无分隔符"

#: includes/class-wpslug-settings.php:748
msgid "Choose the separator between pinyin words."
msgstr "选择拼音单词之间的分隔符。"

#: includes/class-wpslug-settings.php:745
msgid "Preserve English letters in mixed content"
msgstr "在混合内容中保留英文字母"

#: includes/class-wpslug-settings.php:746
msgid "Preserve numbers in slugs"
msgstr "在别名中保留数字"

#: includes/class-wpslug-admin.php:326
msgid "Convert foreign scripts (Cyrillic, Arabic, Greek) to Latin alphabet."
msgstr "将外文字符（西里尔、阿拉伯、希腊）转换为拉丁字母。"

#: includes/class-wpslug-settings.php:749
msgid "Transliteration Method"
msgstr "转写方法"

#: includes/class-wpslug-settings.php:749
msgid "Choose the transliteration method. iconv and Intl provide better accuracy if available."
msgstr "选择转写方法。如果可用，iconv 和 Intl 提供更好的准确性。"

#: includes/class-wpslug-admin.php:331
msgid "Use online translation services to convert text to English slugs."
msgstr "使用在线翻译服务将文本转换为英文别名。"

#: includes/class-wpslug-settings.php:750
msgid "Translation Service"
msgstr "翻译服务"

#: includes/class-wpslug-settings.php:750
msgid "Choose translation service. Useful for non-English content to generate English slugs."
msgstr "选择翻译服务。对于非英文内容生成英文别名很有用。"

#: includes/class-wpslug-settings.php:751
msgid "Source Language"
msgstr "源语言"

#: includes/class-wpslug-settings.php:751
msgid "Source language for translation. Auto-detect is recommended."
msgstr "翻译的源语言。推荐自动检测。"

#: includes/class-wpslug-settings.php:752
msgid "Target Language"
msgstr "目标语言"

#: includes/class-wpslug-settings.php:752
msgid "Target language for translation. English is recommended for SEO."
msgstr "翻译的目标语言。推荐英文以获得更好的 SEO 效果。"

#: includes/class-wpslug-settings.php:755
msgid "API Key"
msgstr "API 密钥"

#: includes/class-wpslug-admin.php:419
#: includes/class-wpslug-admin.php:427
#: includes/class-wpslug-admin.php:639
msgid "Test Connection"
msgstr "测试连接"

#: includes/class-wpslug-settings.php:756
msgid "Enter your Google Translate API key."
msgstr "输入您的谷歌翻译 API 密钥。"

#: includes/class-wpslug-admin.php:421
#: includes/class-wpslug-admin.php:429
msgid "Get API Key"
msgstr "获取 API 密钥"

#: includes/class-wpslug-settings.php:760
msgid "App ID"
msgstr "应用 ID"

#: includes/class-wpslug-settings.php:761
msgid "Enter your Baidu Translate App ID."
msgstr "输入您的百度翻译应用 ID。"

#: includes/class-wpslug-settings.php:766
msgid "Secret Key"
msgstr "密钥"

#: includes/class-wpslug-settings.php:767
msgid "Enter your Baidu Translate Secret Key."
msgstr "输入您的百度翻译密钥。"

#: includes/class-wpslug-admin.php:459
msgid "Learn more"
msgstr "了解更多"

#: includes/class-wpslug-admin.php:336
msgid "Optimize slugs for better search engine performance and user experience."
msgstr "优化别名以获得更好的搜索引擎性能和用户体验。"

#: includes/class-wpslug-settings.php:797
msgid "Enable SEO-friendly slug optimization"
msgstr "启用 SEO 友好的别名优化"

#: includes/class-wpslug-settings.php:797
msgid "Apply SEO best practices to generated slugs."
msgstr "将 SEO 最佳实践应用于生成的别名。"

#: includes/class-wpslug-settings.php:798
msgid "Intelligently handle punctuation marks"
msgstr "智能处理标点符号"

#: includes/class-wpslug-settings.php:798
msgid "Convert colons, semicolons, and other punctuation to hyphens or remove them."
msgstr "将冒号、分号和其他标点符号转换为连字符或删除它们。"

#: includes/class-wpslug-settings.php:799
msgid "Optimize mixed language and number content"
msgstr "优化混合语言和数字内容"

#: includes/class-wpslug-settings.php:799
msgid "Better handling of content mixing languages with numbers and English text."
msgstr "更好地处理语言与数字和英文文本混合的内容。"

#: includes/class-wpslug-settings.php:800
msgid "Remove common stop words from slugs"
msgstr "从别名中删除常见的停用词"

#: includes/class-wpslug-settings.php:800
msgid "Remove words like \"the\", \"a\", \"an\", \"and\", etc. to create cleaner slugs."
msgstr "删除像\"the\"、\"a\"、\"an\"、\"and\"等词语以创建更清洁的别名。"

#: includes/class-wpslug-settings.php:801
msgid "Maximum Words"
msgstr "最大单词数"

#: includes/class-wpslug-settings.php:801
msgid "Maximum number of words to keep in slug for SEO optimization."
msgstr "为 SEO 优化在别名中保留的最大单词数。"

#: includes/class-wpslug-settings.php:802
msgid "Stop Words List"
msgstr "停用词列表"

#: includes/class-wpslug-settings.php:802
msgid "Comma-separated list of stop words to remove from slugs."
msgstr "从别名中删除的停用词的逗号分隔列表。"

#: includes/class-wpslug-admin.php:341
msgid "Configure how media file names are handled during upload."
msgstr "配置上传期间如何处理媒体文件名。"

#: includes/class-wpslug-settings.php:792
msgid "Disable automatic file name conversion for uploaded media"
msgstr "禁用上传媒体的自动文件名转换"

#: includes/class-wpslug-settings.php:792
msgid "When checked, media files will not be converted automatically."
msgstr "选中时，媒体文件不会自动转换。"

#: includes/class-wpslug-settings.php:793
msgid "Media Conversion Mode"
msgstr "媒体转换模式"

#: includes/class-wpslug-settings.php:1020
msgid "Normal Conversion (same as content)"
msgstr "普通转换（与内容相同）"

#: includes/class-wpslug-settings.php:1021
msgid "MD5 Hash (generates unique hash)"
msgstr "MD5 哈希（生成唯一哈希）"

#: includes/class-wpslug-settings.php:1022
msgid "No Conversion (keep original)"
msgstr "不转换（保持原样）"

#: includes/class-wpslug-settings.php:793
msgid "Choose how media file names should be processed. MD5 creates unique hashes for file names."
msgstr "选择如何处理媒体文件名。MD5 为文件名创建唯一哈希。"

#: includes/class-wpslug-settings.php:794
msgid "Media File Prefix"
msgstr "媒体文件前缀"

#: includes/class-wpslug-settings.php:794
msgid "Optional prefix to add to all media file names (e.g., \"img-\", \"file-\")."
msgstr "可选前缀添加到所有媒体文件名（例如：\"img-\"、\"file-\"）。"

#: includes/class-wpslug-settings.php:795
msgid "Always preserve the original file extension"
msgstr "始终保留原始文件扩展名"

#: includes/class-wpslug-settings.php:795
msgid "Ensures file extensions are kept even when using MD5 conversion."
msgstr "确保即使使用 MD5 转换也保留文件扩展名。"

#: includes/class-wpslug-admin.php:344
msgid "Content Types"
msgstr "内容类型"

#: includes/class-wpslug-settings.php:772
msgid "Post Types"
msgstr "文章类型"

#: includes/class-wpslug-settings.php:773
msgid "Select post types to apply slug conversion. If none are selected, every post type is converted."
msgstr "选择要应用别名转换的文章类型。都不勾时，所有文章类型都会转换。"

#: includes/class-wpslug-settings.php:788
msgid "Taxonomies"
msgstr "分类法"

#: includes/class-wpslug-settings.php:789
msgid "Select taxonomies to apply slug conversion. If none are selected, every taxonomy is converted."
msgstr "选择要应用别名转换的分类法。都不勾时，所有分类法都会转换。"

#: includes/class-wpslug-settings.php:796
msgid "Show slug column in post and page lists for easy reference"
msgstr "在文章和页面列表中显示别名列以便于参考"

