msgstr "为您的内容启用自动别名转换"

#: templates/admin/page.php:145
msgid "Conversion Mode"
msgstr "转换模式"

#: templates/admin/page.php:178
msgid "Auto Convert"
msgstr "自动转换"

#: templates/admin/page.php:179
msgid "Automatically convert slugs when saving posts and terms"
msgstr "保存文章和术语时自动转换别名"

#: templates/admin/page.php:196
msgid "Force Lowercase"
msgstr "强制小写"

#: templates/admin/page.php:197
msgid "Convert all slugs to lowercase for consistency"
msgstr "将所有别名转换为小写以保持一致性"

#: includes/class-wpslug-admin.php:232
msgid "Configure Chinese characters to Pinyin romanization."
msgstr "配置中文字符转换到拼音。"

#: includes/class-wpslug-admin.php:277
msgid "Pinyin Format"
msgstr "拼音格式"

#: includes/class-wpslug-admin.php:281
msgid "Full Pinyin (ni-hao)"
msgstr "完整拼音（ni-hao）"

#: includes/class-wpslug-admin.php:284
msgid "First Letter Only (n-h)"
msgstr "仅首字母（n-h）"

#: includes/class-wpslug-admin.php:287
msgid "Choose between full pinyin or first letters only. First letter mode creates very concise URLs and automatically disables SEO optimization."
msgstr "选择完整拼音或仅首字母。首字母模式创建非常简洁的URL并自动禁用SEO优化。"

#: includes/class-wpslug-admin.php:294
msgid "Word Separator"
msgstr "单词分隔符"

#: includes/class-wpslug-admin.php:298
msgid "Dash (-)"
msgstr "破折号（-）"

#: includes/class-wpslug-admin.php:301
msgid "Underscore (_)"
msgstr "下划线（_）"

#: includes/class-wpslug-admin.php:304
msgid "No Separator"
msgstr "无分隔符"

#: includes/class-wpslug-admin.php:307
msgid "Choose the separator between pinyin words."
msgstr "选择拼音单词之间的分隔符。"

#: includes/class-wpslug-admin.php:314
msgid "Preserve Settings"
msgstr "保留设置"

#: includes/class-wpslug-admin.php:323
msgid "Preserve English letters in mixed content"
msgstr "在混合内容中保留英文字母"

#: includes/class-wpslug-admin.php:333
msgid "Preserve numbers in slugs"
msgstr "在别名中保留数字"

#: includes/class-wpslug-admin.php:336
msgid "Keep English letters and numbers when converting mixed language content."
msgstr "转换混合语言内容时保留英文字母和数字。"

#: includes/class-wpslug-admin.php:237
msgid "Convert foreign scripts (Cyrillic, Arabic, Greek) to Latin alphabet."
msgstr "将外文字符（西里尔、阿拉伯、希腊）转换为拉丁字母。"

#: includes/class-wpslug-admin.php:349
msgid "Transliteration Method"
msgstr "转写方法"

#: includes/class-wpslug-admin.php:358
msgid "Choose the transliteration method. iconv and Intl provide better accuracy if available."
msgstr "选择转写方法。如果可用，iconv 和 Intl 提供更好的准确性。"

#: includes/class-wpslug-admin.php:242
msgid "Use online translation services to convert text to English slugs."
msgstr "使用在线翻译服务将文本转换为英文别名。"

#: includes/class-wpslug-admin.php:371
msgid "Translation Service"
msgstr "翻译服务"

#: includes/class-wpslug-admin.php:380
msgid "Choose translation service. Useful for non-English content to generate English slugs."
msgstr "选择翻译服务。对于非英文内容生成英文别名很有用。"

#: includes/class-wpslug-admin.php:387
msgid "Source Language"
msgstr "源语言"

#: includes/class-wpslug-admin.php:396
msgid "Source language for translation. Auto-detect is recommended."
msgstr "翻译的源语言。推荐自动检测。"

#: includes/class-wpslug-admin.php:403
msgid "Target Language"
msgstr "目标语言"

#: includes/class-wpslug-admin.php:412
msgid "Target language for translation. English is recommended for SEO."
msgstr "翻译的目标语言。推荐英文以获得更好的SEO效果。"

#: includes/class-wpslug-admin.php:420
msgid "API Key"
msgstr "API 密钥"

#: includes/class-wpslug-admin.php:428
#: includes/class-wpslug-admin.php:457
#: includes/class-wpslug-admin.php:941
msgid "Test API"
msgstr "测试 API"

#: includes/class-wpslug-admin.php:432
msgid "Enter your Google Translate API key."
msgstr "输入您的谷歌翻译 API 密钥。"

#: includes/class-wpslug-admin.php:434
#: includes/class-wpslug-admin.php:463
msgid "Get API Key"
msgstr "获取 API 密钥"

#: includes/class-wpslug-admin.php:440
msgid "App ID"
msgstr "应用 ID"

#: includes/class-wpslug-admin.php:445
msgid "Enter your Baidu Translate App ID."
msgstr "输入您的百度翻译应用 ID。"

#: includes/class-wpslug-admin.php:449
msgid "Secret Key"
msgstr "密钥"

#: includes/class-wpslug-admin.php:461
msgid "Enter your Baidu Translate Secret Key."
msgstr "输入您的百度翻译密钥。"

#: includes/class-wpslug-admin.php:496
msgid "Learn more"
msgstr "了解更多"

#: includes/class-wpslug-admin.php:247
msgid "Optimize slugs for better search engine performance and user experience."
msgstr "优化别名以获得更好的搜索引擎性能和用户体验。"

#: includes/class-wpslug-admin.php:510
msgid "Enable SEO Optimization"
msgstr "启用 SEO 优化"

#: includes/class-wpslug-admin.php:520
msgid "Enable SEO-friendly slug optimization"
msgstr "启用 SEO 友好的别名优化"

#: includes/class-wpslug-admin.php:523
msgid "Apply SEO best practices to generated slugs."
msgstr "将 SEO 最佳实践应用于生成的别名。"

#: includes/class-wpslug-admin.php:530
msgid "Smart Punctuation"
msgstr "智能标点符号"

#: includes/class-wpslug-admin.php:539
msgid "Intelligently handle punctuation marks"
msgstr "智能处理标点符号"

#: includes/class-wpslug-admin.php:542
msgid "Convert colons, semicolons, and other punctuation to hyphens or remove them."
msgstr "将冒号、分号和其他标点符号转换为连字符或删除它们。"

#: includes/class-wpslug-admin.php:549
msgid "Mixed Content Optimization"
msgstr "混合内容优化"

#: includes/class-wpslug-admin.php:558
msgid "Optimize mixed language and number content"
msgstr "优化混合语言和数字内容"

#: includes/class-wpslug-admin.php:561
msgid "Better handling of content mixing languages with numbers and English text."
msgstr "更好地处理语言与数字和英文文本混合的内容。"

#: includes/class-wpslug-admin.php:568
msgid "Remove Stop Words"
msgstr "删除停用词"

#: includes/class-wpslug-admin.php:578
msgid "Remove common stop words from slugs"
msgstr "从别名中删除常见的停用词"

#: includes/class-wpslug-admin.php:581
msgid "Remove words like \"the\", \"a\", \"an\", \"and\", etc. to create cleaner slugs."
msgstr "删除像\"the\"、\"a\"、\"an\"、\"and\"等词语以创建更清洁的别名。"

#: includes/class-wpslug-admin.php:588
msgid "Maximum Words"
msgstr "最大单词数"

#: includes/class-wpslug-admin.php:595
msgid "Maximum number of words to keep in slug for SEO optimization."
msgstr "为 SEO 优化在别名中保留的最大单词数。"

#: includes/class-wpslug-admin.php:602
msgid "Stop Words List"
msgstr "停用词列表"

#: includes/class-wpslug-admin.php:607
msgid "Comma-separated list of stop words to remove from slugs."
msgstr "从别名中删除的停用词的逗号分隔列表。"

#: includes/class-wpslug-admin.php:252
msgid "Configure how media file names are handled during upload."
msgstr "配置上传期间如何处理媒体文件名。"

#: includes/class-wpslug-admin.php:620
msgid "Media File Conversion"
msgstr "媒体文件转换"

#: includes/class-wpslug-admin.php:629
msgid "Disable automatic file name conversion for uploaded media"
msgstr "禁用上传媒体的自动文件名转换"

#: includes/class-wpslug-admin.php:635
msgid "When checked, media files will not be converted automatically."
msgstr "选中时，媒体文件不会自动转换。"

#: includes/class-wpslug-admin.php:642
msgid "Media Conversion Mode"
msgstr "媒体转换模式"

#: includes/class-wpslug-admin.php:646
#: includes/class-wpslug-settings.php:764
msgid "Normal Conversion (same as content)"
msgstr "普通转换（与内容相同）"

#: includes/class-wpslug-admin.php:649
#: includes/class-wpslug-settings.php:765
msgid "MD5 Hash (generates unique hash)"
msgstr "MD5 哈希（生成唯一哈希）"

#: includes/class-wpslug-admin.php:652
#: includes/class-wpslug-settings.php:766
msgid "No Conversion (keep original)"
msgstr "不转换（保持原样）"

#: includes/class-wpslug-admin.php:655
msgid "Choose how media file names should be processed. MD5 creates unique hashes for file names."
msgstr "选择如何处理媒体文件名。MD5 为文件名创建唯一哈希。"

#: includes/class-wpslug-admin.php:662
msgid "Media File Prefix"
msgstr "媒体文件前缀"

#: includes/class-wpslug-admin.php:667
msgid "Optional prefix to add to all media file names (e.g., \"img-\", \"file-\")."
msgstr "可选前缀添加到所有媒体文件名（例如：\"img-\"、\"file-\"）。"

#: includes/class-wpslug-admin.php:674
msgid "Preserve Original Extension"
msgstr "保留原始扩展名"

#: includes/class-wpslug-admin.php:683
msgid "Always preserve the original file extension"
msgstr "始终保留原始文件扩展名"

#: includes/class-wpslug-admin.php:686
msgid "Ensures file extensions are kept even when using MD5 conversion."
msgstr "确保即使使用 MD5 转换也保留文件扩展名。"

