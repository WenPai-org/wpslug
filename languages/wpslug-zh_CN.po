msgid ""
"WPMind uses AI to translate titles to SEO-friendly slugs. It provides more "
"accurate and context-aware translations compared to traditional translation "
"services."
msgstr ""
"WPMind 使用 AI 将标题翻译为适合 SEO 的 slug，比传统翻译服务更准确，也更能理解"
"上下文。"

msgid ""
"Please install and activate the WPMind plugin to use AI-powered translation."
msgstr "请安装并启用 WPMind 插件以使用 AI 翻译。"

msgid "You are not allowed to manage WPSlug settings."
msgstr "您无权管理 WPSlug 设置。"

msgid "PHP 7.4 or higher is required."
msgstr "需要 PHP 7.4 或更高版本。"

msgid "WordPress 6.0 or higher is required."
msgstr "需要 WordPress 6.0 或更高版本。"

msgid "WPSlug requires PHP 7.4 or higher. Please upgrade your PHP version."
msgstr "WPSlug 需要 PHP 7.4 或更高版本。请升级 PHP。"

msgid ""
"WPSlug requires WordPress 6.0 or higher. Please upgrade your WordPress "
"version."
msgstr "WPSlug 需要 WordPress 6.0 或更高版本。请升级 WordPress。"

